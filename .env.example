# ===================================================================
# Professor Carvalho - BigMonCraft (BigBangCraft)
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commitar o .env. Proteja com: chmod 600 .env
# ===================================================================

# -------------------------------------------------------------------
# Application
# -------------------------------------------------------------------
NODE_ENV=development
TZ=America/Sao_Paulo
APP_NAME=Professor Carvalho
APP_VERSION=0.1.0
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000
SHUTDOWN_TIMEOUT_MS=15000

# -------------------------------------------------------------------
# Discord
# -------------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_COMMAND_REGISTRATION_MODE=guild
DISCORD_DEV_GUILD_ID=
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_SPAWN_ALERT_CHANNEL_ID=
DISCORD_PRIVATE_SPAWN_ALERT_CHANNEL_ID=
DISCORD_SHINY_ALERT_ROLE_ID=
DISCORD_LEGENDARY_ALERT_ROLE_ID=
DISCORD_PROFESSOR_AVATAR_URL=
DISCORD_DEFAULT_EPHEMERAL_ERRORS=true

# -------------------------------------------------------------------
# BigMonCraft
# -------------------------------------------------------------------
BIGMONCRAFT_SERVER_ID=bigmoncraft
BIGMONCRAFT_SERVER_NAME=BigMonCraft
BIGMONCRAFT_SERVER_ADDRESS=bigmoncraft.bigbangcraft.com.br
BIGMONCRAFT_SITE_URL=
BIGMONCRAFT_MODPACK_URL=
BIGMONCRAFT_MODPACK_VERSION=

# -------------------------------------------------------------------
# PostgreSQL
# -------------------------------------------------------------------
POSTGRES_DB=professor_carvalho
POSTGRES_USER=professor_carvalho
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://professor_carvalho:CHANGE_ME@postgres:5432/professor_carvalho
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000

# -------------------------------------------------------------------
# Redis and BullMQ
# -------------------------------------------------------------------
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
REDIS_KEY_PREFIX=professor-carvalho:
QUEUE_DEFAULT_ATTEMPTS=5
QUEUE_DEFAULT_BACKOFF_MS=2000
QUEUE_JOB_TIMEOUT_MS=15000

# -------------------------------------------------------------------
# Pokémon data
# -------------------------------------------------------------------
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
POKEAPI_REQUEST_TIMEOUT_MS=5000
POKEAPI_USER_AGENT=ProfessorCarvalho/0.1.0 BigMonCraft
POKEMON_CACHE_TTL_SECONDS=86400
POKEMON_CACHE_STALE_TTL_SECONDS=604800
POKEMON_NEGATIVE_CACHE_TTL_SECONDS=600
COBBLEMON_SNAPSHOT_PATH=/app/data/generated/bigmoncraft-spawns.json
COBBLEMON_SNAPSHOT_REQUIRED=false

# -------------------------------------------------------------------
# Cobblemon Spawn Alerts integration
# -------------------------------------------------------------------
CSA_INTEGRATION_MODE=disabled
CSA_SOURCE_TOKEN=
CSA_ALLOWED_CIDRS=
CSA_BODY_LIMIT_BYTES=65536
CSA_DEDUP_WINDOW_SECONDS=90
CSA_STORE_SANITIZED_PAYLOAD_DAYS=14
CSA_EXPECTED_SOURCE_VERSION=1.13.2

# -------------------------------------------------------------------
# Spawn privacy
# -------------------------------------------------------------------
SPAWN_COORDINATE_POLICY=hidden
SPAWN_REGION_GRID_SIZE=500
SPAWN_SHOW_NEAREST_PLAYER=false
SPAWN_STORE_EXACT_COORDINATES=false

# -------------------------------------------------------------------
# Rate limiting
# -------------------------------------------------------------------
HTTP_RATE_LIMIT_MAX=60
HTTP_RATE_LIMIT_WINDOW_SECONDS=60
DISCORD_COMMAND_COOLDOWN_SECONDS=3
DISCORD_EXPENSIVE_COMMAND_COOLDOWN_SECONDS=10

# -------------------------------------------------------------------
# Metrics
# -------------------------------------------------------------------
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=
METRICS_INCLUDE_DEFAULT_METRICS=true

# -------------------------------------------------------------------
# Future Fabric gateway — disabled in MVP
# -------------------------------------------------------------------
GATEWAY_INGRESS_ENABLED=false
GATEWAY_SHARED_SECRET=
GATEWAY_ALLOWED_CLOCK_SKEW_SECONDS=60
GATEWAY_ALLOWED_CIDRS=
