# Professor Carvalho — Nginx (proxy VPS)
#
# Requisitos:
#   - Nginx escuta SOMENTE no IP WireGuard do proxy (WIREGUARD_PROXY_IP).
#   - A rota CSA aceita apenas o CIDR WireGuard do servidor Minecraft.
#   - Sem access log na rota tokenizada.
#   - Corpo limitado a 64 KiB; timeouts curtos (o CSA 1.13.2 não tem timeout próprio).
#   - X-Forwarded-For usa APENAS $remote_addr (o peer real), nunca o cabeçalho
#     enviado pelo cliente — assim um XFF forjado não atravessa o proxy.
#
# Substitua:
#   WIREGUARD_PROXY_IP  -> IP WireGuard do proxy (ex.: 10.66.0.1)
#   MINECRAFT_WIREGUARD_CIDR -> CIDR do servidor Minecraft (ex.: 10.66.0.2/32)

server {
    listen WIREGUARD_PROXY_IP:80;
    server_name _;

    # Nada é servido fora das localizações explícitas abaixo.
    deny all;

    # ------------------------------------------------------------------
    # Relay CSA (tokenizado) — privado, somente WireGuard.
    # ------------------------------------------------------------------
    location /v1/integrations/csa/ {
        allow MINECRAFT_WIREGUARD_CIDR;
        deny all;

        # Limites e timeouts: o CSA não configura timeout; se o relay
        # demorar, o CSA apenas registra a falha no log do servidor.
        client_max_body_size 64k;
        client_body_timeout 10s;
        proxy_connect_timeout 3s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;

        proxy_pass http://127.0.0.1:3080;
        proxy_set_header Host $host;
        # IMPORTANTE: apenas o par TCP real. NUNCA $proxy_add_x_forwarded_for.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # A URL contém o token: nada de access log nesta rota.
        access_log off;
    }

    # ------------------------------------------------------------------
    # Health — somente localhost (127.0.0.1 / ::1).
    # ------------------------------------------------------------------
    location /health {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://127.0.0.1:3080;
        proxy_set_header Host $host;
        access_log off;
    }

    # ------------------------------------------------------------------
    # Métricas — somente localhost (além disso, o /metrics exige
    # METRICS_BEARER_TOKEN na aplicação).
    # ------------------------------------------------------------------
    location /metrics {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://127.0.0.1:3080;
        proxy_set_header Host $host;
        access_log off;
    }
}

# PostgreSQL e Redis NUNCA são expostos via Nginx (rede Docker interna).
# Endpoints do Discord não passam por este servidor.
