{
  "configVersion": "1.13.2",
  "comment": [
    "Webhook do Professor Carvalho para o servidor BigMonCraft (Modo Relay).",
    "Substitua COLE_A_URL_DO_RELAY_AQUI pela URL completa fornecida pelo administrador da rede.",
    "",
    "Formato: http://<ip-wireguard-do-proxy>/v1/integrations/csa/<source-token>",
    "O token é secreto e nunca deve ser compartilhado fora da equipe administrativa.",
    "",
    "O campo 'content' contém metadados em formato machine-readable (PC_CSA_V1).",
    "O embed fornecido é usado como fallback caso o relay esteja indisponível.",
    "https://stainlessstasis.github.io/CSA-Docs/config/"
  ],
  "webhookURL": "COLE_A_URL_DO_RELAY_AQUI",
  "webhookContent": {
    "content": "PC_CSA_V1|dex={dex_unformatted}|lvl={level_unformatted}|x={x}|y={y}|z={z}|biome={biome_unformatted}|bucket={bucket_unformatted}|shiny={shiny_unformatted}|leg={legendary_unformatted}|myth={mythical_unformatted}|ub={ultrabeast_unformatted}|par={paradox_unformatted}|ha={hidden_ability_unformatted}|name={name}|player={nearest_player_unformatted}|ts={timestamp}",
    "username": "Professor Carvalho",
    "avatarURL": "",
    "tts": false,
    "embeds": [
      {
        "enabled": true,
        "title": "**{shiny}{legendary}{bucket}{name} apareceu em {biome}!**",
        "description": "**Número da Dex**: #{dex}\\n**Nível**: {level}\\n**Raridade**: {bucket}\\n**Bioma**: {biome}\\n**Habilidade**: {ability}",
        "color": "",
        "url": "",
        "imageURL": "",
        "thumbnailURL": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/{dex}.png",
        "timestamp": false,
        "author": {
          "name": "",
          "url": "",
          "iconURL": ""
        },
        "fields": [],
        "footer": {
          "text": "BigMonCraft • Radar do Professor Carvalho",
          "iconURL": ""
        }
      }
    ]
  }
}
